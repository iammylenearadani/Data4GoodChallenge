# In the browser Kiro you can leave the 3 key lines EMPTY (credentials are built in).
# On your own laptop: paste the temporary credentials from AWS Workshop Studio ("Get AWS CLI credentials")
# They expire after a few hours — re-paste if you get ExpiredToken errors.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=eu-central-1

# Bedrock model ids — check the Bedrock console "Model catalog" for what's enabled in YOUR account
# and copy the exact id (some regions need an inference profile id like "us.anthropic....").
BEDROCK_MODEL_ID=
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
